Spanish battle-name order: the ROM's " salvaje" / " enemigo" follow the name. Applied only to
the Spanish staging tree (tools/locales/localize.py). Adapted from pokeemerald-vita-3ds
tools/locales/es/patches/07-native-name-prefix-order.patch, itself from Emerald 3DS
(CC BY-NC-SA 4.0, NOTICE.md).

--- a/src/battle_message.c
+++ b/src/battle_message.c
@@ -1820,27 +1820,41 @@ static const u8 *TryGetStatusString(u8 *src)
     return NULL;
 }
 
+// Spanish build (tools/locales/es/patches): the ROM's prefixes are suffixes with a leading space
+// (" salvaje", " enemigo") and the Spanish engine writes them after the name. Copy the name, then
+// the suffix, into dst here, and leave toCpy on the name's terminator so the copy the caller makes
+// afterwards adds nothing.
 #define HANDLE_NICKNAME_STRING_CASE(battlerId, monIndex)                \
     if (GetBattlerSide(battlerId) != B_SIDE_PLAYER)                     \
+        GetMonData(&gEnemyParty[monIndex], MON_DATA_NICKNAME, text);    \
+    else                                                                \
+        GetMonData(&gPlayerParty[monIndex], MON_DATA_NICKNAME, text);   \
+    StringGet_Nickname(text);                                           \
     {                                                                   \
-        if (gBattleTypeFlags & BATTLE_TYPE_TRAINER)                     \
-            toCpy = sText_FoePkmnPrefix;                                \
-        else                                                            \
-            toCpy = sText_WildPkmnPrefix;                               \
+        const u8 *nameEnd;                                              \
+        toCpy = text;                                                   \
         while (*toCpy != EOS)                                           \
         {                                                               \
             dst[dstId] = *toCpy;                                        \
             dstId++;                                                    \
             toCpy++;                                                    \
         }                                                               \
-        GetMonData(&gEnemyParty[monIndex], MON_DATA_NICKNAME, text);    \
-    }                                                                   \
-    else                                                                \
-    {                                                                   \
-        GetMonData(&gPlayerParty[monIndex], MON_DATA_NICKNAME, text);   \
-    }                                                                   \
-    StringGet_Nickname(text);                                           \
-    toCpy = text;
+        nameEnd = toCpy;                                                \
+        if (GetBattlerSide(battlerId) != B_SIDE_PLAYER)                 \
+        {                                                               \
+            if (gBattleTypeFlags & BATTLE_TYPE_TRAINER)                 \
+                toCpy = sText_FoePkmnPrefix;                            \
+            else                                                        \
+                toCpy = sText_WildPkmnPrefix;                           \
+            while (*toCpy != EOS)                                       \
+            {                                                           \
+                dst[dstId] = *toCpy;                                    \
+                dstId++;                                                \
+                toCpy++;                                                \
+            }                                                           \
+        }                                                               \
+        toCpy = nameEnd;                                                \
+    }
 
 u32 BattleStringExpandPlaceholders(const u8 *src, u8 *dst)
